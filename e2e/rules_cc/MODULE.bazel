bazel_dep(name = "bazel_lib", version = "3.0.0")
bazel_dep(name = "bazel_features", version = "1.42.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

bazel_dep(name = "external_include_paths_test", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "external_include_paths_test",
    path = "external_include_paths_test",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "with_cfg.bzl", version = "0.12.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "llvm", version = "")
local_path_override(
    module_name = "llvm",
    path = "../../",
)

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm-project")

gcc = use_extension("@llvm//3rd_party/gcc/extension:gcc.bzl", "gcc")
use_repo(gcc, "gcc")

musl = use_extension("@llvm//runtimes/musl/extension:musl.bzl", "musl")
use_repo(musl, "musl_libc")

# Register toolchains through the scoped repo to ensure this codepath works.
llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
use_repo(llvm_toolchains, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# Bump transitive zlib version to avoid genrules.
bazel_dep(name = "zlib", version = "1.3.1.bcr.8")

# Prototype: consume the linkage API from the forks.
git_override(
    module_name = "rules_cc",
    commit = "280ea50eaf1fe86eb8e56a2126997e48a41f0905",
    remote = "https://github.com/fmeum/rules_cc.git",
)

git_override(
    module_name = "platforms_contrib",
    commit = "2e37a56febc823c7edb98196d4f02f2af0028714",
    remote = "https://github.com/fmeum/platforms_contrib.git",
)
