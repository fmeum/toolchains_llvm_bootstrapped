load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@toolchains_llvm_bootstrapped//:defs.bzl", "exec_test")
load(":defs.bzl", "mingw_arm64_cc_binary", "mingw_cc_binary", "ubsan_cc_binary")

cc_binary(
    name = "main",
    srcs = ["main.cc"],
    # We provide these libs explicitly via the toolchain runtime_library.
    # These options are all no-ops as they resolve to empty stubs.
    # This is basically a test that we can properly ignore these opts.
    linkopts = [
        "-lc++",
        "-lc++abi",
        "-lunwind",
    ],
)

# TODO(zbarsky): Turn more of this into a macro once we have more sanitizers?
ubsan_cc_binary(
    name = "ubsan_fail",
    srcs = ["ubsan_fail.cc"],
)

exec_test(
    sh_test,
    name = "ubsan_output_test",
    srcs = ["ubsan_output_test.sh"],
    data = [":ubsan_fail"],
    env = {"BINARY": "$(rootpath :ubsan_fail)"},
)

mingw_cc_binary(
    name = "mingw_hello",
    srcs = ["mingw_hello.cc"],
    copts = [
        "-fno-exceptions",
        "-fno-rtti",
        "-fno-stack-protector",
    ],
    linkopts = [
        "-nostdlib",
        "-Wl,-entry=_start",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
    ],
)

mingw_arm64_cc_binary(
    name = "mingw_hello_arm64",
    srcs = ["mingw_hello.cc"],
    copts = [
        "-fno-exceptions",
        "-fno-rtti",
        "-fno-stack-protector",
    ],
    linkopts = [
        "-nostdlib",
        "-Wl,-entry=_start",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
    ],
)

exec_test(
    sh_test,
    name = "mingw_binary_format_test",
    srcs = ["mingw_binary_format_test.sh"],
    data = [":mingw_hello"],
    env = {
        "BINARY": "$(rootpath :mingw_hello)",
        "EXPECTED_PATTERN": "PE32\\+ executable \\(console\\) x86-64",
    },
    target_compatible_with = [
        "@platforms//os:windows",
    ],
)

exec_test(
    sh_test,
    name = "mingw_arm64_binary_format_test",
    srcs = ["mingw_binary_format_test.sh"],
    data = [":mingw_hello_arm64"],
    env = {
        "BINARY": "$(rootpath :mingw_hello_arm64)",
        "EXPECTED_PATTERN": "PE32\\+ executable \\(console\\) Aarch64",
    },
    target_compatible_with = [
        "@platforms//os:windows",
    ],
)
