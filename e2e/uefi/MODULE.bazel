bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_platform", version = "0.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_qemu", version = "0.3.0")
bazel_dep(name = "llvm", version = "")
local_path_override(
    module_name = "llvm",
    path = "../../",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

qemu = use_extension("@rules_qemu//qemu/extension:qemu.bzl", "qemu")
qemu.system_toolchain(
    system_target = "x86_64-softmmu",
    target_settings = ["//:qemu_system_x86_64"],
)
use_repo(
    qemu,
    "qemu_system_toolchains",
    "qemu_user_toolchains",
)

register_toolchains(
    "@llvm//toolchain:all",
    "@qemu_system_toolchains//:all",
)

# Prototype: consume the linkage API from the forks.
git_override(
    module_name = "rules_cc",
    commit = "e61cb4aca5d0a6c57348fa3e5ef00aa4c37bac41",
    remote = "https://github.com/fmeum/rules_cc.git",
)

git_override(
    module_name = "platforms_contrib",
    commit = "e6d2a9faf6e93336a2b5307e93906b1d69c2ce2f",
    remote = "https://github.com/fmeum/platforms_contrib.git",
)
