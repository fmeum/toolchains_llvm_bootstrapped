module(name = "llvm_version_selection")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "llvm", version = "")
local_path_override(
    module_name = "llvm",
    path = "../..",
)

LLVM_VERSION = "21.1.8"

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = LLVM_VERSION)
use_repo(llvm, "llvm-project")

toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
use_repo(toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# Prototype: consume the linkage API from the forks.
git_override(
    module_name = "rules_cc",
    commit = "280ea50eaf1fe86eb8e56a2126997e48a41f0905",
    remote = "https://github.com/fmeum/rules_cc.git",
)

git_override(
    module_name = "platforms_contrib",
    commit = "2e37a56febc823c7edb98196d4f02f2af0028714",
    remote = "https://github.com/fmeum/platforms_contrib.git",
)
